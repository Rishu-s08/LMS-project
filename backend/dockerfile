# Choose a lightweight Node.js base image
FROM node:20-alpine

# Set the working directory inside the container
WORKDIR /app

# Copy dependency manifests first for better layer caching
COPY package*.json ./

# Install dependencies (use npm install or npm ci)
RUN npm install

# Copy the rest of the application source code
COPY . .

# 🔥 CRUCIAL FOR PRISMA: Generate the Prisma client types inside the container
RUN npx prisma generate

# Expose the application port
EXPOSE 3000

# Start the application
CMD ["npm", "run", "dev"]
